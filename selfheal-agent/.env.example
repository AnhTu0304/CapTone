# SelfHeal Kubernetes Agent Configuration

# Backend API endpoint URL
SELFHEAL_BACKEND_URL=http://localhost:8000

# Agent Identity and Authentication Token
SELFHEAL_AGENT_ID=agent-k8s-cluster-01
SELFHEAL_AGENT_TOKEN=sh_sec_demo_token_change_me_in_production

# Heartbeat interval in seconds (default: 10)
SELFHEAL_HEARTBEAT_INTERVAL=10

# Kubernetes Cluster Connection Mode: LOCAL or IN_CLUSTER
SELFHEAL_KUBERNETES_MODE=LOCAL

# Optional custom kubeconfig file path (used only when mode is LOCAL)
# KUBECONFIG_PATH=/path/to/custom/kubeconfig

# Network Timeouts (seconds)
HTTP_CONNECT_TIMEOUT=5.0
HTTP_REQUEST_TIMEOUT=10.0

# Structured Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Structured Log Format: json or text
LOG_FORMAT=json
