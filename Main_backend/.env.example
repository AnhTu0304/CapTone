PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=captone_db
DB_POOL_MAX=20
# DATABASE_URL=postgresql://user:password@localhost:5432/captone_db

# AI Backend Configuration
AI_BACKEND_URL=http://localhost:8001

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_development_only
JWT_EXPIRES_IN=7d

# SMTP Email Configuration (Nodemailer)
# (Để trống khi chạy dev, hệ thống sẽ tự động in OTP ra console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM="AI Self-Heal Support" <noreply@selfheal.io>
CLIENT_URL=http://localhost:3000
