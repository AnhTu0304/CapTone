PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=selfheal_app
DB_PASSWORD=your_runtime_app_password
DB_NAME=captone_db
DB_POOL_MAX=20
# Sprint C Phase 3: PostgreSQL TLS (disable in local dev only; verify-full required in staging/production)
DB_SSL_MODE=disable
# DB_SSL_CA_PATH=/etc/postgresql/certs/ca.crt
# Separate least-privilege migration role (used strictly by migrate scripts / CI/CD)
# DB_MIGRATOR_USER=selfheal_migrator
# DB_MIGRATOR_PASSWORD=your_migrator_password
# DATABASE_URL=postgresql://user:password@localhost:5432/captone_db

# AI Backend Configuration
AI_BACKEND_URL=http://localhost:8001
AI_INTERNAL_HMAC_SECRET=dev_only_ai_internal_hmac_secret_32_characters_long

# JWT Security Configuration
# Generate a secure key in production with: openssl rand -base64 32
# In production, server startup will fail if JWT_SECRET is unset or less than 32 characters.
JWT_SECRET=dev_only_jwt_secret_key_minimum_32_characters_long_12345
JWT_ACCESS_EXPIRES_IN=15m
# Legacy fallback only; access tokens default to 15m (JWT_ACCESS_EXPIRES_IN)
JWT_EXPIRES_IN=7d
# Sprint C Phase 2: Refresh Token & Cookie Hardening
# Generate with: openssl rand -hex 32 (required in production if distinct from JWT_SECRET)
REFRESH_TOKEN_PEPPER=dev_only_refresh_token_pepper_min_32_characters_long
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_SESSION_MAX_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
TOTP_ENCRYPTION_KEY=dev_only_totp_encryption_key_min_32_characters_long

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# SMTP Email Configuration (Nodemailer)
# (Để trống khi chạy dev, hệ thống sẽ tự động in OTP ra console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM="AI Self-Heal Support" <noreply@selfheal.io>
CLIENT_URL=http://localhost:3000

# Redis Cache Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_TTL=300
REDIS_ENABLED=true

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# OpenTelemetry Configuration
OTEL_ENABLED=true
OTEL_SERVICE_NAME=selfheal-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_SERVICE_NAMESPACE=selfheal-system
DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRIC_EXPORT_INTERVAL_MS=15000
K8S_NAMESPACE_NAME=selfheal-system
K8S_POD_NAME=local-backend-pod
K8S_NODE_NAME=minikube
