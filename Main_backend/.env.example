PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=captone_db
DB_POOL_MAX=20
# DATABASE_URL=postgresql://user:password@localhost:5432/captone_db

# AI Backend Configuration
AI_BACKEND_URL=http://localhost:8001

# JWT Security Configuration
# Generate a secure key in production with: openssl rand -base64 32
# In production, server startup will fail if JWT_SECRET is unset or less than 32 characters.
JWT_SECRET=dev_only_jwt_secret_key_minimum_32_characters_long_12345
JWT_EXPIRES_IN=7d

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# SMTP Email Configuration (Nodemailer)
# (Để trống khi chạy dev, hệ thống sẽ tự động in OTP ra console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM="AI Self-Heal Support" <noreply@selfheal.io>
CLIENT_URL=http://localhost:3000

# Redis Cache Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_TTL=300
REDIS_ENABLED=true

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
