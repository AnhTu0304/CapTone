### ===================================================================
### AI RISK PREDICTION API TESTS (POST /api/v1/ai/predict)
### Models: GRU Multi-Label (12 timesteps x 8 features)
### Database: aiselfheal (ai_predictions & prediction_inputs)
### ===================================================================

@baseUrl = http://localhost:5000/api/v1
@contentType = application/json

### -------------------------------------------------------------------
### TEST 1: High Load / Critical Risk (CPU Overload & Spike)
### Expected: 201 Created, status: RISK_DETECTED, primary_risk: CPU_OVERLOAD
### -------------------------------------------------------------------
POST {{baseUrl}}/ai/predict
Content-Type: {{contentType}}

{
  "service_id": "payment-service",
  "prediction_horizon_minutes": 15,
  "sequence": [
    { "cpu": 55.0, "ram": 60.0, "disk": 40.0, "latency": 120.0, "request_rate": 200.0, "http_5xx_rate": 0.5, "pod_restart_count": 0, "replica_count": 3 },
    { "cpu": 58.5, "ram": 61.2, "disk": 40.5, "latency": 135.0, "request_rate": 220.0, "http_5xx_rate": 0.6, "pod_restart_count": 0, "replica_count": 3 },
    { "cpu": 63.0, "ram": 63.0, "disk": 41.0, "latency": 150.0, "request_rate": 250.0, "http_5xx_rate": 0.8, "pod_restart_count": 0, "replica_count": 3 },
    { "cpu": 68.2, "ram": 65.1, "disk": 41.5, "latency": 180.0, "request_rate": 290.0, "http_5xx_rate": 1.1, "pod_restart_count": 0, "replica_count": 3 },
    { "cpu": 72.0, "ram": 68.0, "disk": 42.0, "latency": 210.0, "request_rate": 320.0, "http_5xx_rate": 1.5, "pod_restart_count": 0, "replica_count": 3 },
    { "cpu": 76.5, "ram": 70.4, "disk": 42.5, "latency": 250.0, "request_rate": 360.0, "http_5xx_rate": 2.0, "pod_restart_count": 1, "replica_count": 3 },
    { "cpu": 80.0, "ram": 72.0, "disk": 43.0, "latency": 290.0, "request_rate": 400.0, "http_5xx_rate": 2.8, "pod_restart_count": 1, "replica_count": 3 },
    { "cpu": 83.4, "ram": 74.5, "disk": 43.5, "latency": 320.0, "request_rate": 430.0, "http_5xx_rate": 3.5, "pod_restart_count": 1, "replica_count": 3 },
    { "cpu": 86.0, "ram": 76.0, "disk": 44.0, "latency": 360.0, "request_rate": 460.0, "http_5xx_rate": 4.2, "pod_restart_count": 2, "replica_count": 3 },
