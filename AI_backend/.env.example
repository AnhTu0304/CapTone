APP_NAME=AI-Driven Self-Healing Backend
APP_ENV=development
LOG_LEVEL=INFO
GRU_MODEL_PATH=saved_models/gru_model_8feature.pth
# Empty means: use the validation-selected risk_threshold embedded in the checkpoint
GRU_RISK_THRESHOLD=

# Optional OpenAI RCA. Never commit the real key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30
