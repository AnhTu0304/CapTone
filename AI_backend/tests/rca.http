@baseUrl = http://127.0.0.1:8000

### POST /api/v1/rca - RCA tối thiểu, không chạy GRU
POST {{baseUrl}}/api/v1/rca
Content-Type: application/json
Accept: application/json
X-Request-ID: test-rca-minimal-001

{
  "service_id": "payment-service",
  "pod_id": "payment-service-7c9d8f6b5-x2abc",
  "metrics": {
    "cpu": 35,
    "ram": 50,
    "disk": 65,
    "request_rate": 500,
    "latency": 2500,
    "http_5xx_rate": 15,
    "pod_restart_count": 2,
    "replica_count": 3
  },
  "logs": [
    "ERROR Readiness probe failed while serving requests"
  ],
  "kubernetes": {
    "pod_status": "Running",
    "container_status": "Running",
    "restart_count": 2,
    "events": ["Readiness probe failed"],
    "desired_replicas": 3,
    "available_replicas": 3,
    "readiness_probe": "Failed",
    "liveness_probe": "Passed"
  }
}

