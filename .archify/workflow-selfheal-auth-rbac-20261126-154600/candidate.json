  "cards": [
    {
      "dot": "emerald",
      "title": "Defense-in-Depth Session Model",
      "items": [
        "Short-lived JWT access token is stored strictly in RAM (never in localStorage) to prevent XSS token theft",
        "Session restoration uses HttpOnly refresh cookies paired with X-CSRF-Token double-submit verification"
      ]
    },
    {
      "dot": "rose",
      "title": "2-Tier RBAC Hierarchy",
      "items": [
        "Platform System Roles: SUPER_ADMIN > ADMIN > USER",
        "Tenant Organization Roles: SME_OWNER > DEVOPS > VIEWER (scoped via X-Organization-Id and PostgreSQL RLS)"
      ]
    }
