  "cards": [
    {
      "dot": "emerald",
      "title": "7-Container Control Plane",
      "items": [
        "Nginx reverse proxy terminates TLS (:8090/:8443) and routes to React 19 SPA, Main Backend, and Agent Installer",
        "Main Backend (Node.js Express TS) enforces 6-tier RBAC, RAM JWT + HttpOnly refresh cookie + CSRF, and MAPE-K policy orchestration",
        "AI Backend (FastAPI + PyTorch Multi-Head GRU) is internal-only on :8000 and protected by AI_INTERNAL_HMAC_SECRET"
      ]
    },
    {
      "dot": "cyan",
      "title": "Persistence & Telemetry",
      "items": [
        "PostgreSQL 16 (captone_db) stores 41 relational tables with Row-Level Security (RLS) and SHA-256 immutable audit logs",
        "Redis 7 caches active sessions, token revocation blacklists, rate limits, and 12x8 telemetry windows"
      ]
    },
    {
      "dot": "rose",
      "title": "Edge Kubernetes Loop",
      "items": [
        "SelfHeal Edge Agent (Python 3.11 DaemonSet) streams metrics, logs, and K8s events over WSS with zero inbound ports required",
        "High-risk healing actions (ROLLBACK_DEPLOYMENT, DRAIN_NODE) enforce mandatory SME_OWNER HITL approval before execution"
      ]
    }
